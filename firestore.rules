rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vokabeltrainer: jede:r Lernende hat einen Bereich learners/<name>.
    // Zugriff nur über die Seite (anonyme Firebase-Anmeldung, unsichtbar für Moritz).
    match /learners/{learner} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && learner.matches('^[a-z0-9-]{1,30}$')
        && request.resource.data.keys().hasOnly(['name', 'lastSeen']);
      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.size() < 20;
      }
    }
  }
}
