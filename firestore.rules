rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur die beiden eingetragenen Google-Konten dürfen Moritz' Fortschritt lesen und schreiben.
    // E-MAIL-MARTIN und E-MAIL-MORITZ durch die echten Google-Adressen ersetzen.
    match /learners/{learner}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['E-MAIL-MARTIN', 'E-MAIL-MORITZ'];
    }
  }
}
